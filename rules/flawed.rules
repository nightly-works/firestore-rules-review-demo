rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /coachProfiles/{coachId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == coachId;
    }

    match /workouts/{workoutId} {
      allow read: if request.auth != null
        && (resource.data.premium == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'premium');
    }

    match /bookings/{bookingId} {
      allow read, update: if request.auth != null
        && (resource.data.clientId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if request.auth != null;
    }

    match /healthNotes/{noteId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 1);
    }
  }
}
